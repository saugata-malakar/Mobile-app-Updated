# DiabetesCare AI — Environment Variables
# Copy this to .env and fill in values

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/diabetescare
# On Render: automatically injected from database service

# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-minimum-32-chars-change-this
ENCRYPTION_KEY=your-32-byte-aes-key-change-this-now

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
DEBUG=true

# ── CORS (set to your frontend URL in production) ──────────────────────────
CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://your-vercel-app.vercel.app

# ── AI Models ─────────────────────────────────────────────────────────────
WOUND_MODEL_PATH=models/wound_severity/best_model.pth
SKIN_MODEL_PATH=models/skin_classifier/best_model_fix1.pth

# ── Gemini (for multimodal AI) ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Mobile app backend URL (update in api.ts too) ─────────────────────────
# Local:      http://localhost:8000
# Render:     https://diabetescare-ai-api.onrender.com
# Your PC IP: http://192.168.x.x:8000
